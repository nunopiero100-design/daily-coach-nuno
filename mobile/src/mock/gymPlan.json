          {
            "n": "Seated hamstring curl",
            "sr": "3 x 12-15",
            "load": "RPE 8 - rest 75s",
            "note": "Light, controlled - hamstring/knee support."
          },
          {
            "n": "Low step-ups (15-20 cm box)",
            "sr": "3 x 8 / leg",
            "load": "bodyweight/light - rest 75s",
            "note": "No deep bend; control the way down."
          },
          {
