            "note": "Full stretch at top."
          },
          {
            "n": "Seated cable row",
            "sr": "3 x 10-12",
            "load": "RPE 8 - rest 90s",
            "note": "Squeeze shoulder blades, no torso swing."
          },
          {
            "n": "Face pulls",
            "sr": "3 x 15",
            "load": "RPE 8 - rest 60s",
            "note": "Posture / rear delts - big for road position."
          },
          {
            "n": "Single-arm DB row",
            "sr": "3 x 10 / side",
            "load": "RPE 8 - rest 75s",
            "note": "Control the lowering."
          },
          {
            "n": "Biceps curls",
            "sr": "3 x 12",
            "load": "RPE 9 - rest 60s",
            "note": "Strict."
          },
          {
            "n": "Pallof press + dead bug",
            "sr": "3 x 10 / side",
            "load": "light band - rest 45s",
            "note": "Anti-rotation core."
          }
        ]
